NEXT_PUBLIC_LIVE_WS_URL=ws://localhost:8000/v1/live/ws
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional R2 replay Worker base URL used for offline/latest replay fallback.
NEXT_PUBLIC_REPLAY_API_URL=
# The bundled WebGL fly/table assets are the default; set false for a deterministic CSS-only fallback.
NEXT_PUBLIC_ENABLE_WEBGL_SCENE=true
# Optional production art override. When unset, /models/spyfly.glb is used.
# Supply a same-origin or CORS-enabled .glb/.gltf URL to replace it.
NEXT_PUBLIC_FLY_GLTF_URL=
FLYPOKER_CONNECTIONS_PER_MINUTE=240
FLYPOKER_MODE=simulated
FLY_DEVICE=cuda
FLY_DATA=fly-data
FLYPOKER_READOUT_DIR=artifacts/readout-male-cns-gpu
FLY_VARIANT=profiles
FLYPOKER_ALLOWED_ORIGINS=http://localhost:3000
FLYPOKER_REQUIRE_ORIGIN=false
FLYPOKER_MAX_SPECTATORS=200
# FLYPOKER_REPLAY_UPLOAD_URL=https://replays.example/ingest
# FLYPOKER_REPLAY_UPLOAD_TOKEN=replace-me
